# =========================================================================
# VocalLabs Hackathon - AI Customer Support Agent Deployment Configuration
# =========================================================================

# 1. Google Gemini API Key (Required for RAG Embeddings and LLM Generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. PostgreSQL Database Configuration
POSTGRES_DB=ai_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# 3. Microservice Ports
FRONTEND_PORT=5173
BACKEND_PORT=8080
NLP_PORT=8000

# 4. NLP Service Mode
# Set to 'false' to connect to the live Python FastAPI NLP service, 
# Set to 'true' to use the lightweight built-in mock heuristic engine
NLP_MOCK_ENABLED=false
