# Database Configuration
DATABASE_URL=sqlite:///./nlp_local.db
# For PostgreSQL: postgresql://postgres:password@localhost:5432/nlp_db

# Classification Thresholds
DOMAIN_CONFIDENCE_THRESHOLD=0.55
INTENT_CONFIDENCE_THRESHOLD=0.50
LANGUAGE_CONFIDENCE_THRESHOLD=0.60

# Service & Logging
SERVICE_NAME=nlp-service
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO
STORE_RAW_TEXT=true
MODEL_DIR=./models
DEVICE=cpu
